# Frontend Environment Variables

# ============================================================================
# API CONFIGURATION
# ============================================================================

# Backend API URL (REQUIRED)
# This is the URL where your FastAPI backend server is running
#
# Development (local backend):
#   VITE_API_URL=http://localhost:8000
#
# Production:
#   VITE_API_URL=https://api.yourdomain.com
#
# Note: No trailing slash
VITE_API_URL=http://localhost:8000

# ============================================================================
# SETUP INSTRUCTIONS
# ============================================================================
#
# 1. Copy this file to .env in the same directory:
#    cp .env.example .env
#
# 2. Update VITE_API_URL to match your backend server URL
#
# 3. For development, the default http://localhost:8000 should work
#    if your backend is running on port 8000
#
# 4. The variable name must start with VITE_ to be exposed to the app
#    (Vite's environment variable convention)
#
# 5. After changing .env, restart the dev server:
#    npm run dev
#
# ============================================================================
