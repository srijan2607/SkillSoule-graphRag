# Backend Environment Variables

# ============================================================================
# API CONFIGURATION
# ============================================================================

# Application environment (development, staging, production)
# Affects logging, error handling, and security settings
APP_ENV=development

# Enable debug mode (True/False)
# WARNING: Set to False in production for security
DEBUG=True

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# API server host (use 0.0.0.0 to accept connections from any IP)
API_HOST=0.0.0.0

# API server port
API_PORT=8000

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# PostgreSQL Database (REQUIRED)
# Format: postgresql://username:password@host:port/database
# Free tier options: Supabase (https://supabase.com), Render (https://render.com)
# Local example: postgresql://postgres:postgres@localhost:5432/career_ai
DATABASE_URL=postgresql://user:password@localhost:5432/career_ai

# Neo4j Graph Database (REQUIRED)
# Free tier: Neo4j Aura (https://neo4j.com/cloud/aura-free/)
# Cloud format: neo4j+s://xxxxx.databases.neo4j.io (note the +s for SSL)
# Local format: neo4j://localhost:7687 (without SSL)
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io

# Neo4j username (default is 'neo4j')
NEO4J_USER=neo4j

# Neo4j password
# For Aura: Generated during database creation (save it!)
# For local: Default is 'neo4j' but must be changed on first login
NEO4J_PASSWORD=your-neo4j-password

# ============================================================================
# AUTHENTICATION & SECURITY (REQUIRED)
# ============================================================================

# JWT Secret Key
# CRITICAL: Generate a strong random key for production
# Generate with: openssl rand -hex 32
# Keep this secret and never commit to version control
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# JWT signing algorithm (recommended: HS256)
JWT_ALGORITHM=HS256

# JWT token expiration in hours (default: 24)
# Users will need to re-login after this period
JWT_EXPIRATION_HOURS=24

# ============================================================================
# LLM API CONFIGURATION (REQUIRED)
# ============================================================================

# OpenRouter API (REQUIRED for LLM responses)
# Get your API key: https://openrouter.ai/keys
# Free tier available with models like meta-llama/llama-3.3-8b-instruct:free
OPENROUTER_API_KEY=sk-or-v1-your-api-key-here

# OpenRouter API base URL (usually no need to change)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# OpenRouter model to use
# Free options: meta-llama/llama-3.3-8b-instruct:free
# Paid options: anthropic/claude-3-sonnet, openai/gpt-4, etc.
# See full list: https://openrouter.ai/models
OPENROUTER_MODEL=meta-llama/llama-3.3-8b-instruct:free

# ============================================================================
# EMBEDDING MODEL CONFIGURATION (REQUIRED)
# ============================================================================

# HuggingFace embedding model (runs locally, no API key needed)
# Default: sentence-transformers/all-MiniLM-L6-v2 (384 dimensions)
# Alternatives:
#   - all-mpnet-base-v2 (768 dim, higher quality, slower)
#   - all-distilroberta-v1 (768 dim, good balance)
# Model will be auto-downloaded on first use
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Embedding vector dimension (must match model)
# all-MiniLM-L6-v2: 384
# all-mpnet-base-v2: 768
# all-distilroberta-v1: 768
EMBEDDING_DIMENSION=384

# ============================================================================
# CSV INGESTION CONFIGURATION (OPTIONAL)
# ============================================================================

# Maximum CSV file size in megabytes
# Increased to 500MB for larger datasets
# Be mindful of memory usage with very large files
MAX_FILE_SIZE_MB=500

# Processing batch size for CSV rows
# Larger = faster but more memory usage
# Smaller = slower but less memory usage
# Default 1000 provides good balance
BATCH_SIZE=1000

# Maximum allowed batch size (validation limit)
# Prevents memory issues with extremely large batches
MAX_BATCH_SIZE=5000

# ============================================================================
# CORS CONFIGURATION (OPTIONAL)
# ============================================================================

# Allowed CORS origins (comma-separated)
# Add your frontend URLs here
# For development: http://localhost:5173,http://localhost:3000
# For production: https://yourdomain.com
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ============================================================================
# SETUP INSTRUCTIONS
# ============================================================================
#
# 1. Copy this file to .env in the same directory:
#    cp .env.example .env
#
# 2. Fill in all REQUIRED values (marked above)
#
# 3. Generate JWT_SECRET:
#    openssl rand -hex 32
#
# 4. Set up databases:
#    - Neo4j: https://neo4j.com/cloud/aura-free/
#    - PostgreSQL: https://supabase.com or local
#
# 5. Get OpenRouter API key:
#    https://openrouter.ai/keys
#
# 6. Run Prisma migrations:
#    prisma generate
#    prisma db push
#
# 7. Start the server:
#    uvicorn app.main:app --reload
#
# ============================================================================
